# Copy to backend/.env for local development (git-ignored). On Render, set these as environment
# variables instead. Never commit real values.

# The Supabase project the web app signs in with (Project Settings -> API). Required.
SUPABASE_URL=https://<project-ref>.supabase.co

# Server-only key for the scans table (Project Settings -> API Keys -> Secret keys, sb_secret_...).
# Leave empty to keep scans in memory (they are lost when the server stops). Never put this key in
# the frontend or in any VITE_ variable.
SUPABASE_SECRET_KEY=

# The web app's address(es), comma-separated. Only these origins may call the API from a browser.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# The VulnShop lab: the one target this server scans, and its two test accounts.
LAB_URL=http://127.0.0.1:8000
LAB_USER_A=alice
LAB_PASSWORD_A=alice
LAB_USER_B=bob
LAB_PASSWORD_B=bob

# Limits (defaults shown), the same for every account.
SCANS_PER_DAY=5
GLOBAL_SCANS_PER_DAY=50
SCAN_BURST=15
SCAN_MAX_REQUESTS=400
RETENTION_DAYS=30
REQUESTS_PER_MINUTE_IP=60
REQUESTS_PER_MINUTE_USER=30
# Users' own APIs: how many one account may add, and scans per API per day (across all accounts).
TARGETS_PER_USER=3
SCANS_PER_TARGET_PER_DAY=3
# Seconds a scan waits for the target to answer its health check (it may be starting). 0 = no wait.
TARGET_WAKE_SECONDS=30

# The header the proxy in front sets to the caller's address, overwriting any the caller sent:
# cf-connecting-ip on Render. Empty locally (the connection's address is used). Never
# x-forwarded-for: it can be forged.
CLIENT_IP_HEADER=

# Google sign-in from the web app's own button: the OAuth web client (Google Cloud -> Google Auth
# Platform -> Clients). The id is public; the secret is server-only and must never go in the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
