# apifuzz settings. Copy this file to .env and fill in your own values; .env is git-ignored.
# `apifuzz scan` reads them; command-line options override them.

# Where the API under test lives. If empty, the spec's first "servers" entry is used, but only
# when the spec was downloaded from that same host or the host is in APIFUZZ_ALLOWLIST below.
# A spec file may not choose the target on its own.
APIFUZZ_BASE_URL=

# Hosts apifuzz may send requests to, comma-separated. Each is "host" (any port) or "host:port".
# Requests to any other host are refused. Example: localhost:8000,staging.example.com
APIFUZZ_ALLOWLIST=

# Two DIFFERENT test accounts, A and B. The bola check uses A's token to try to read B's objects
# (and the reverse). Use throwaway staging accounts, never real users or production credentials.
#
# Either give each account a token...
APIFUZZ_TOKEN_A=
APIFUZZ_TOKEN_B=
# ...or a username and password, and apifuzz logs in itself by POSTing {"username", "password"}
# to APIFUZZ_LOGIN_PATH. A token, when set, wins over the username and password.
APIFUZZ_USER_A=
APIFUZZ_PASSWORD_A=
APIFUZZ_USER_B=
APIFUZZ_PASSWORD_B=
APIFUZZ_LOGIN_PATH=/login
# How the login request is encoded: json (default) or form. The field names can be changed too,
# e.g. APIFUZZ_LOGIN_USER_FIELD=email.
APIFUZZ_LOGIN_FORMAT=
APIFUZZ_LOGIN_USER_FIELD=
APIFUZZ_LOGIN_PASSWORD_FIELD=

# How a token is sent. Leave empty to follow the spec's security scheme ("Authorization: Bearer
# <token>" when the spec doesn't say). Example for "X-API-Key: <token>": APIFUZZ_AUTH_HEADER=X-API-Key
# Example for "Authorization: Token <token>": APIFUZZ_AUTH_PREFIX=Token
APIFUZZ_AUTH_HEADER=
APIFUZZ_AUTH_PREFIX=

# Paths whose objects are shared between users on purpose, comma-separated shell-style patterns.
# The bola check skips them. Example: /posts/*,/products/*
APIFUZZ_SHARED=

# Set to 1 to refuse any scan whose target isn't a running local Docker container
# (same as --require-docker). Recommended when your test API runs in Docker.
APIFUZZ_REQUIRE_DOCKER=
