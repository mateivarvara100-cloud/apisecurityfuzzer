# apifuzz settings. Copy this file to .env and fill in your own values; .env is git-ignored.
# `apifuzz scan` reads them; command-line options override them.

# Where the API under test lives. Leave empty to use the first "servers" entry in the spec.
APIFUZZ_BASE_URL=

# Hosts apifuzz may send requests to, comma-separated. Each is "host" (any port) or "host:port".
# Requests to any other host are refused. Example: localhost:8000,staging.example.com
APIFUZZ_ALLOWLIST=

# Two DIFFERENT test accounts, A and B. The bola check uses A's token to try to read B's objects
# (and the reverse). Use throwaway staging accounts, never real users or production credentials.
#
# Either give each account a token, sent as "Authorization: Bearer <token>"...
APIFUZZ_TOKEN_A=
APIFUZZ_TOKEN_B=
# ...or a username and password, and apifuzz logs in itself by POSTing {"username", "password"}
# to APIFUZZ_LOGIN_PATH. A token, when set, wins over the username and password.
APIFUZZ_USER_A=
APIFUZZ_PASSWORD_A=
APIFUZZ_USER_B=
APIFUZZ_PASSWORD_B=
APIFUZZ_LOGIN_PATH=/login

# Set to 1 to refuse any scan whose target isn't a running local Docker container
# (same as --require-docker). Recommended when your test API runs in Docker.
APIFUZZ_REQUIRE_DOCKER=
