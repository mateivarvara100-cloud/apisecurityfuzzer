# Copy to .env.local. Vite exposes only VITE_* variables, and everything here ends up in the
# browser bundle, so never put a secret in this file.

# "mock" (default) uses the bundled sample scan and keeps scan history in this browser.
# "live" will call the backend below once it exists.
VITE_API_MODE=mock

# The Phase 4 FastAPI backend (on Render). Not built yet.
VITE_API_URL=

# Who runs this deployment, shown in the terms and privacy notice. Required before going public.
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=

# Supabase project URL and its public anon key (safe to ship to the browser). With both set,
# sign-in is real: "Continue with Google" and e-mail + password both go through Supabase Auth.
# Left empty, sign-in is simulated. Never put the secret key (sb_secret_...) or service_role key here.
# The key may be given as VITE_SUPABASE_PUBLISHABLE_KEY (what Supabase's Connect dialog shows)
# or VITE_SUPABASE_ANON_KEY (the older name).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google OAuth web client id (Google Cloud -> Google Auth Platform -> Clients). Public. With it,
# Google's own sign-in button is used, so Google's screen names this site, not <project>.supabase.co.
VITE_GOOGLE_CLIENT_ID=

# The one target the demo may scan: the VulnShop lab. The real allowlist lives on the server;
# the browser copy is only used to explain a refusal before a request is sent.
VITE_DEMO_TARGET=http://127.0.0.1:8000
